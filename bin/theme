#!/usr/bin/env bash
# theme — switch the colour theme across Ghostty (and herdr), tmux, nvim, starship, sketchybar,
# borders and the desktop wallpaper.
#
#   theme                       pick a theme with fzf
#   theme <name>                apply a theme
#   theme --list                list themes
#   theme --current             print the active theme
#   theme --next-bg             cycle to the theme's next wallpaper
#   theme --fetch-backgrounds   download wallpapers from Omarchy into themes/*/backgrounds/
#
# Themes live in ~/dotfiles/themes/<name>/. The active one is the symlink
# ~/.local/state/theme/current; every app's config reads from that fixed path,
# so switching is: repoint the symlink, regenerate starship, nudge running apps.

set -euo pipefail

DOTFILES="$HOME/dotfiles"
THEMES="$DOTFILES/themes"
STATE="$HOME/.local/state/theme"
CURRENT="$STATE/current"

list_themes() {
  find "$THEMES" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

current_theme() {
  [[ -L $CURRENT ]] && basename "$(readlink "$CURRENT")"
}

# Colour swatches for the fzf preview, taken from the theme's tmux palette.
preview() {
  local file="$THEMES/$1/tmux.conf" key hex r g b
  echo "$1"
  echo
  while read -r _ _ key hex; do
    key=${key#@thm_}
    hex=${hex//\"/}
    hex=${hex#\#}
    r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
    printf '\e[48;2;%d;%d;%dm      \e[0m  %-10s #%s\n' "$r" "$g" "$b" "$key" "$hex"
  done < <(grep '^set -g @thm_' "$file")
}

pick() {
  local current
  current=$(current_theme || true)
  list_themes | fzf \
    --prompt 'theme> ' \
    --header "current: ${current:-none}" \
    --height 60% --reverse \
    --preview "$0 --preview {}" \
    --preview-window right,45%
}

# Wallpapers live in themes/<name>/backgrounds/ (gitignored; see --fetch-backgrounds).
# The one last used per theme is remembered in $STATE/backgrounds/<name>.
backgrounds() {
  find -L "$CURRENT/backgrounds/" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.heic' \) \
    2>/dev/null | sort
}

# AppleScript only reaches the current Space, so the picture is written into every Space's entry
# in macOS's wallpaper store instead, and WallpaperAgent is restarted to pick it up.
WALLPAPER_STORE="$HOME/Library/Application Support/com.apple.wallpaper/Store/Index.plist"

set_wallpaper() {
  if ! python3 -I - "$WALLPAPER_STORE" "$1" <<'EOF'
import datetime, pathlib, plistlib, sys

store, url = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]).resolve().as_uri()
data = plistlib.loads(store.read_bytes())
IMAGE = 'com.apple.wallpaper.choice.image'

entries = []
for space in (data.get('Spaces') or {}).values():
    entries.append(space.get('Default'))
    entries += (space.get('Displays') or {}).values()
entries += (data.get('Displays') or {}).values()
desktops = [e['Desktop'] for e in entries if isinstance(e, dict) and isinstance(e.get('Desktop'), dict)]

# Spaces on a dynamic wallpaper get an image choice built from an existing one.
template = next((c for d in desktops for c in d['Content']['Choices'] if c.get('Provider') == IMAGE), None)
for desktop in desktops:
    choices = desktop['Content']['Choices']
    images = [c for c in choices if c.get('Provider') == IMAGE]
    if not images and template:
        images = [dict(template)]
        desktop['Content']['Choices'] = images
    for choice in images:
        choice['Files'] = [{'relative': url}]
    desktop['LastSet'] = datetime.datetime.now()

if not desktops:
    sys.exit(1)
store.write_bytes(plistlib.dumps(data, fmt=plistlib.FMT_BINARY))
EOF
  then
    # No store entries yet (fresh machine): fall back to the current Space only.
    osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$1\"" \
      >/dev/null 2>&1 || echo "theme: couldn't set the wallpaper" >&2
    return
  fi
  killall WallpaperAgent 2>/dev/null || true
}

set_background() {
  local name remembered pick
  name=$(current_theme)
  pick=$(backgrounds | head -1)
  [[ -n $pick ]] || return 0

  # Remembered by filename: paths through $CURRENT point at whichever theme is active.
  remembered=$(cat "$STATE/backgrounds/$name" 2>/dev/null || true)
  [[ -n $remembered && -f $CURRENT/backgrounds/$remembered ]] && pick="$CURRENT/backgrounds/$remembered"
  set_wallpaper "$(realpath "$pick")"
}

next_background() {
  local name current next
  name=$(current_theme)
  current=$(cat "$STATE/backgrounds/$name" 2>/dev/null || true)
  # Nothing remembered means the first one is showing.
  [[ -n $current ]] || current=$(basename "$(backgrounds | head -1)")
  next=$(backgrounds | awk -v cur="$current" 'found { print; exit } { n = $0; sub(/.*\//, "", n) } n == cur { found = 1 }')
  # Wrap around after the last one, or start at the first.
  [[ -n $next ]] || next=$(backgrounds | head -1)
  [[ -n $next ]] || { echo "theme: $name has no backgrounds (try: theme --fetch-backgrounds)" >&2; exit 1; }

  mkdir -p "$STATE/backgrounds"
  basename "$next" >"$STATE/backgrounds/$name"
  set_wallpaper "$(realpath "$next")"
  echo "background: $(basename "$next")"
}

# Copies each theme's wallpapers from Omarchy (github.com/omacom/omarchy, themes/<name>/backgrounds),
# leaving out the ones carrying the Omarchy logo.
BRANDED=(-iname 'omarchy*' -o -iname '*-omarchy-*' -o -iname '*-oma.*' -o -iname '*-oma-*')

fetch_backgrounds() {
  local name src count
  FETCH_TMP=$(mktemp -d)
  trap 'rm -rf "$FETCH_TMP"' EXIT
  git clone -q --depth 1 --filter=blob:none --sparse https://github.com/omacom/omarchy "$FETCH_TMP/omarchy"
  git -C "$FETCH_TMP/omarchy" sparse-checkout set --no-cone '/themes/*/backgrounds/*' '!/themes/*/backgrounds/intros'

  for name in $(list_themes); do
    src="$FETCH_TMP/omarchy/themes/${name/#catppuccin-mocha/catppuccin}/backgrounds"
    [[ -d $src ]] || { echo "  $name: none in Omarchy"; continue; }
    mkdir -p "$THEMES/$name/backgrounds"
    find "$src" -maxdepth 1 -type f ! \( "${BRANDED[@]}" \) -exec cp {} "$THEMES/$name/backgrounds/" \;
    find "$THEMES/$name/backgrounds" -maxdepth 1 -type f \( "${BRANDED[@]}" \) -delete
    count=$(find -L "$THEMES/$name/backgrounds" -maxdepth 1 -type f | wc -l | tr -d ' ')
    echo "  $name: $count"
  done
}

apply() {
  local name="$1" src="$THEMES/$1"
  [[ -d $src ]] || { echo "theme: no such theme '$name' (try: theme --list)" >&2; exit 1; }

  mkdir -p "$STATE"
  ln -sfn "$src" "$CURRENT"

  # starship re-reads its config on every prompt, so this is live on the next one.
  cat "$DOTFILES/.config/starship.toml" "$src/starship.toml" >"$STATE/starship.toml.tmp"
  mv "$STATE/starship.toml.tmp" "$STATE/starship.toml"

  # Ghostty includes current/ghostty.conf; herdr uses the terminal palette, so it follows.
  if pgrep -xq ghostty; then
    osascript -e 'tell application "Ghostty" to perform action "reload_config" on terminal 1' \
      >/dev/null 2>&1 || echo "theme: couldn't reload Ghostty (reload it with cmd+shift+,)" >&2
  fi

  # tmux.conf sources current/tmux.conf before the catppuccin plugin re-renders.
  if tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
  fi

  # nvim re-applies its colorscheme on SIGUSR1 (see lua/popmatik/theme.lua).
  pkill -USR1 -x nvim 2>/dev/null || true

  # sketchybarrc and its plugins read colours via .config/sketchybar/colors.sh.
  if pgrep -xq sketchybar; then
    sketchybar --reload >/dev/null 2>&1 || true
  fi

  set_background

  # Invoking borders again updates the running instance.
  if pgrep -xq borders; then
    # shellcheck disable=SC2046
    borders $(cat "$src/borders") >/dev/null 2>&1 &
  fi

  echo "theme: $name"
}

case "${1:-}" in
  "") choice=$(pick) && [[ -n $choice ]] && apply "$choice" ;;
  --list | -l) list_themes ;;
  --current | -c) current_theme ;;
  --next-bg | -b) next_background ;;
  --fetch-backgrounds) fetch_backgrounds ;;
  --preview) preview "$2" ;;
  -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) apply "$1" ;;
esac
